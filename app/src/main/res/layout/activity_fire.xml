<?xml version="1.0" encoding="utf-8"?>


    <!-- activity_fire_report.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
    android:id="@+id/main"
android:orientation="vertical"
android:padding="16dp">

<!-- Title Text -->
<TextView
    android:id="@+id/reportTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/fire_report"
    android:textSize="24sp"
    android:textStyle="bold"
    android:gravity="center"
    android:layout_marginBottom="20dp" />

<!-- Description Field -->
<EditText
    android:id="@+id/editDescription"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/enter_description_of_the_fire"
    android:inputType="textMultiLine"
    android:lines="3"
    android:layout_marginBottom="16dp" />

<!-- Location Field -->
<EditText
    android:id="@+id/editLocation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/enter_location"
    android:inputType="text"
    android:layout_marginBottom="16dp" />

<!-- Image Preview -->
<ImageView
    android:id="@+id/imageViewPreview"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:contentDescription="@string/imagepreview"
    android:src="@android:drawable/ic_menu_camera"
    android:layout_marginBottom="16dp"
    android:scaleType="centerCrop" />

<!-- Upload Image Button -->
<Button
    android:id="@+id/btnUploadImage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/upload_image" />

<!-- Submit Report Button -->
<Button
    android:id="@+id/submitReportButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/submit_report" />
</LinearLayout>
